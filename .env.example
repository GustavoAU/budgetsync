# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth scopes requested at login, separated by spaces.
# Ask only for what the app uses: profile + email to sign in, spreadsheets to read the budget.
VITE_GOOGLE_SCOPE=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/spreadsheets

# Google Sheet used as the budget data source (not wired up yet)
VITE_GOOGLE_SHEETS_ID=
VITE_GOOGLE_SHEET_RANGE=Sheet1!A1:D10
